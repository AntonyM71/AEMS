{
  "name": "Python 3 & PostgreSQL",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "24"},
    "ghcr.io/va-h/devcontainers-features/uv:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,readonly"
  ],
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [5432],

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "bash .devcontainer/setupEnvs.sh",

  // Configure tool-specific properties.
  // "customizations": {},

  // Use vscode user to avoid WSL permission issues with generated files (like devcontainer-lock.json)
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscodeshift.mui-snippets",
        "ms-vscode-remote.remote-containers",
        "kevinrose.vsc-python-indent",
        "oderwat.indent-rainbow",
        "esbenp.prettier-vscode",
        "sonarsource.sonarlint-vscode",
        "naumovs.color-highlight",
        "zainchen.json",
        "tamasfe.even-better-toml",
        "charliermarsh.ruff",
        "donjayamanne.githistory",
        "dsznajder.es7-react-js-snippets",
        "ms-python.python",
        "ms-python.debugpy",
        "KevinRose.vsc-python-indent",
        "mgesbert.python-path",
        "yzhang.markdown-all-in-one",
        "ms-azuretools.vscode-docker",
        "Zignd.html-css-class-completion",
        "ms-vscode.vscode-typescript-next",
        "dbaeumer.vscode-eslint",
        "bierner.markdown-mermaid",
        "Anthropic.claude-code"
      ]
    }
  }
}
